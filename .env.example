# Браузер (попадает в код сайта — только публичные значения)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_DEFAULT_STUDIO=aqualine

# Сервер (только в Vercel → Settings → Environment Variables и в локальном .env, никогда в коде)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
OPENAI_API_KEY=sk-...
# Модель помощника меняется здесь, без правки кода
OPENAI_MODEL=gpt-4o-mini
# Лимит обращений к помощнику: запросов на одного посетителя в 10 минут
AI_LIMIT_PER_10_MIN=20

# Адрес сайта на Vercel (нужен боту для кнопки «Открыть приложение» и для скриптов)
SITE_URL=https://aqualine.vercel.app
# Любая длинная строка: защищает ежедневную рассылку напоминаний
CRON_SECRET=
